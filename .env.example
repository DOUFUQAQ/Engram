# ============================================================================
# .env.example —— 复制成 .env 后填入你的 key
# ============================================================================
#   Windows:  copy .env.example .env
#   Linux/mac: cp .env.example .env
#
# 代码会自动读取同目录下的 .env（零依赖解析，见 embedder.load_dotenv）。
# .env 已在 .gitignore 里，**不会被提交到 GitHub**。
#
# 两个组件是独立的，可以只配一个：
#   ① 嵌入（EMBED_*）   —— 解决"意思像"，是检索质量的主要来源
#   ② 重排（DEEPSEEK_*）—— 解决"因果链"，用 chat 模型给候选打分
#
# ⚠️ 一个必须先说清楚的事实：
#    DeepSeek 官方 API（api.deepseek.com）**只提供 chat/completions，没有 embeddings 端点**。
#    所以 EMBED_* 需要指向别的厂商或自建服务，推荐 BGE-M3（中文检索强、1024 维、便宜）。
#    而 DEEPSEEK_* 用于 ② 的 LLM 重排 —— 这正是"用 v4 flash"的地方。
# ----------------------------------------------------------------------------


# ── ① 嵌入（OpenAI 兼容 /v1/embeddings）─────────────────────────────────────
# 方案 A：硅基流动 SiliconFlow（有免费额度，BGE-M3，中文强）
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_API_KEY=
EMBED_MODEL=BAAI/bge-m3

# 方案 B：阿里云百炼 DashScope（OpenAI 兼容模式）
# EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBED_MODEL=text-embedding-v3

# 方案 C：OpenAI
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_MODEL=text-embedding-3-small

# 方案 D：自建（Ollama 需以 `ollama serve --embeddings` 启动；vLLM/TEI 同理）
# EMBED_BASE_URL=http://127.0.0.1:11434/v1
# EMBED_API_KEY=ollama
# EMBED_MODEL=bge-m3

# 可选微调（留空即用默认）
EMBED_DIM=                 # 留空 = 首次调用自动探测
EMBED_BATCH=32             # 批量入库时的批大小
EMBED_TIMEOUT=30
EMBED_QUERY_PREFIX=        # E5 系模型需要 "query: "；bge-m3 不需要
EMBED_DOC_PREFIX=          # E5 系模型需要 "passage: "；bge-m3 不需要


# ── ② LLM 重排（chat/completions，用 deepseek v4 flash）─────────────────────
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat          # 换成你账号里 v4 flash 的实际 model id
RERANK_ENABLED=1
RERANK_MAX_CANDIDATES=12              # 每次重排送几个候选给模型（越多越贵）
RERANK_SNIPPET_CHARS=600              # 每个候选截断多少字符
RERANK_TIMEOUT=60


# ── ③ 开关 ─────────────────────────────────────────────────────────────────
# 设为 1 时：缺少在线嵌入会直接报错，而不是静默退化成离线哈希嵌入。
# 强烈建议在验证"真嵌入有没有效果"时打开 —— 否则配置写错会得出错误结论。
STRICT_EMBEDDINGS=0
