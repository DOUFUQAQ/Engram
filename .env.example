# ============================================================================
# .env.example —— 复制成 .env 后填入你的 key
# ============================================================================
#   Windows:  copy .env.example .env
#   Linux/mac: cp .env.example .env
#
# 代码会自动读取同目录下的 .env（零依赖解析，见 embedder.load_dotenv）。
# .env 已在 .gitignore 里，**不会被提交到 GitHub**。
#
# 两个组件相互独立，可以只配一个：
#   ① 嵌入（EMBED_*）   —— 解决"意思像"，是检索质量的主要来源
#   ② 重排（DEEPSEEK_*）—— 解决"因果链"，用 chat 模型给候选打分
#
# 配完先跑体检，它会告诉你端点/模型/key 到底配没配上：
#   python run_experiment.py --check
# 端点对不上时也能用探测器自动找可用组合：
#   python probe_provider.py
# ----------------------------------------------------------------------------


# ════════════════════════════════════════════════════════════════════════════
# 方案 A（本项目实测通过）：全部用火山方舟 Ark 一个 key 搞定
# ════════════════════════════════════════════════════════════════════════════
# 如果你的 key 前缀是 ark-，那它就是方舟的，base_url 必须是下面这个。
#
# ⚠️ 方舟的坑（实测踩过）：
#   · 文本嵌入也走 **/embeddings/multimodal**！走 /embeddings 会直接 404
#     "InvalidEndpointOrModel.NotFound: the model does not exist"，
#     看起来像"这个账号没有嵌入能力"，其实路径不对。
#   · 响应结构也不同：data 是**对象** {embedding:[...]} 而不是数组。
#     （已在本项目 embedder.py 里自动兼容两种结构）
#   · input 必须包成 [{"type":"text","text":"..."}]，不能直接传字符串数组。
#   · 模型清单里大量嵌入模型标着 Retiring，当前唯一 Published 的是
#     doubao-embedding-vision-251215（2048 维），它对文本输入一样可用。
#
# 实测效果：中文语义近邻 同义对 0.619 / 无关对 0.385（有真实判别力）
EMBED_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBED_API_PATH=/embeddings/multimodal
EMBED_INPUT_STYLE=multimodal
EMBED_API_KEY=
EMBED_MODEL=doubao-embedding-vision-251215

DEEPSEEK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-1-flash-260910


# ════════════════════════════════════════════════════════════════════════════
# 方案 B：DeepSeek 官方做重排 + 别家嵌入
# ════════════════════════════════════════════════════════════════════════════
# ⚠️ DeepSeek 官方 API（api.deepseek.com）**只提供 chat/completions，
#    没有 embeddings 端点**。所以 EMBED_* 必须指向别处。
#
# 嵌入可选（任一）：
#   · 硅基流动 SiliconFlow（有免费额度，BGE-M3 中文强）
#       EMBED_BASE_URL=https://api.siliconflow.cn/v1
#       EMBED_MODEL=BAAI/bge-m3
#   · 阿里云百炼 DashScope
#       EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#       EMBED_MODEL=text-embedding-v3
#   · OpenAI
#       EMBED_BASE_URL=https://api.openai.com/v1
#       EMBED_MODEL=text-embedding-3-small
#   · 自建（Ollama 需以 `ollama serve --embeddings` 启动；vLLM/TEI 同理）
#       EMBED_BASE_URL=http://127.0.0.1:11434/v1
#       EMBED_API_KEY=ollama
#       EMBED_MODEL=bge-m3
#
# 换成上面任一家时，记得把这两行删掉或改回标准值：
#   EMBED_API_PATH=/embeddings        （默认值，标准 OpenAI 路径）
#   EMBED_INPUT_STYLE=auto            （默认值，按路径自动判别）
#
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat


# ── 可选微调（留空即用默认）────────────────────────────────────────────────
EMBED_DIM=                 # 留空 = 首次调用自动探测
EMBED_BATCH=32             # 批量入库时的批大小
EMBED_TIMEOUT=30
EMBED_QUERY_PREFIX=        # E5 系模型需要 "query: "；bge-m3 不需要
EMBED_DOC_PREFIX=          # E5 系模型需要 "passage: "；bge-m3 不需要

RERANK_ENABLED=1
RERANK_MAX_CANDIDATES=12   # 每次重排送几个候选给模型（越多越贵）
RERANK_SNIPPET_CHARS=600   # 每个候选截断多少字符
RERANK_TIMEOUT=60

# 设为 1 时：缺少在线嵌入会直接报错，而不是静默退化成离线哈希嵌入。
# 强烈建议在验证"真嵌入有没有效果"时打开 —— 否则配置写错会得出错误结论。
STRICT_EMBEDDINGS=0
